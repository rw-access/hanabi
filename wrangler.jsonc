{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hanabi",
  "main": "dist/worker/entry.py",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {"pattern": "rw-access.dev/play/hanabi", "zone_name": "rw-access.dev"},
    {"pattern": "rw-access.dev/play/hanabi/*", "zone_name": "rw-access.dev"},
    {"pattern": "www.rw-access.dev/play/hanabi", "zone_name": "rw-access.dev"},
    {"pattern": "www.rw-access.dev/play/hanabi/*", "zone_name": "rw-access.dev"}
  ],
  "assets": {
    "directory": "dist/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{"name": "ROOMS", "class_name": "GameRoom"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["GameRoom"]}]
}
